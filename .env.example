# =============================================================================
# infra-as-code — Variables d'environnement (exemple)
# =============================================================================
# Utilisation :
#   1. cp .env.example .env
#   2. Remplacer TOUTES les valeurs CHANGE_ME (git les ignore deja : .env est
#      dans .gitignore, ce fichier .env.example ne contient aucun secret).
#   3. Generer les secrets :  openssl rand -hex 24
#   4. Hash WireGuard :       docker run --rm ghcr.io/wg-easy/wg-easy:14 \
#                               wgpw '<mot-de-passe>'
#
# La CI (.github/workflows/ci.yml) execute `cp .env.example .env` puis
# `docker compose config -q` : TOUTE variable referencee dans
# docker-compose.yml doit donc exister ici, avec une valeur non vide.
# =============================================================================

# --- Generale ---------------------------------------------------------------
# Fuseau horaire applies a tous les conteneurs (Zabbix, Grafana, WireGuard...)
TZ=Europe/Paris

# --- PostgreSQL 16 (administrateur de la base de donnees) -------------------
# Compte admin cree au premier demarrage : sert a l'administration et aux
# scripts d'initialisation (docker/postgres/initdb/).
POSTGRES_DB=infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_DB

# --- Base Zabbix (creee par docker/postgres/initdb/01-init-databases.sh) -----
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=CHANGE_ME_ZABBIX_DB

# --- Base Grafana (creee par le meme script d'initialisation) ----------------
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=CHANGE_ME_GRAFANA_DB

# --- Grafana (authentification de l'interface d'administration) --------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN
# Plugins installes au premier demarrage (necessite un acces sortant).
# Laisser vide pour desactiver l'installation automatique.
GF_INSTALL_PLUGINS=grafana-zabbix-datasource
# Publication sur la loopback uniquement : acces via SSH tunnel ou NPM.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# --- Zabbix server (collecte) ------------------------------------------------
# Port trapper/agent passif (10051) — boucle locale uniquement.
ZABBIX_BIND=127.0.0.1
ZABBIX_SERVER_PORT=10051

# --- Prometheus --------------------------------------------------------------
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s

# --- Netdata (metrique temps reel, hote + conteneurs) ------------------------
NETDATA_BIND=127.0.0.1
NETDATA_PORT=19999
# 1 = telemetrie Netdata coupee (recommande sur un VPS de production)
NETDATA_DISABLE_TELEMETRY=1

# --- Nginx Proxy Manager (seule porte publique du stack) ---------------------
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# Interface d'administration NPM : loopback uniquement (tunnel SSH requis).
NGINX_PM_ADMIN_BIND=127.0.0.1
NGINX_PM_ADMIN_PORT=81

# --- WireGuard / wg-easy -----------------------------------------------------
# Adresse publique (IP ou FQDN) annoncee aux clients comme endpoint WireGuard.
WIREGUARD_HOST=CHANGE_ME_VPS_PUBLIC_IP
WIREGUARD_BIND=0.0.0.0
WIREGUARD_PORT=51820
# Interface web wg-easy : loopback uniquement.
WIREGUARD_UI_BIND=127.0.0.1
WIREGUARD_UI_PORT=51821
WIREGUARD_DNS=1.1.1.1
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
# Mot de passe souhaite pour l'interface web — usage DOCUMENTAIRE UNIQUEMENT :
# wg-easy (v14) n'accepte que le hash bcrypt, il est saisi ci-dessous.
WIREGUARD_PASSWORD=changeme
# Hash bcrypt du mot de passe ci-dessus.
# Generation :  docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'mon-passe'
# ATTENTION : Docker Compose interpole les fichiers .env, chaque "$" du hash
# doit donc etre double ("$$") sinon la salte est avalée et le hash casse.
# Valeur de demonstration : hash bcrypt de "changeme" → A CHANGER.
WIREGUARD_PASSWORD_HASH=$$2b$$10$$PkNRqHWQBSmFTXNlUkk2muKQveVBIu0paA/y0Ar8jdI8QeF8Emq3e

# --- HashiCorp Vault (secrets) ------------------------------------------------
# Accessible uniquement en loopback : consulter via `docker exec` ou tunnel.
VAULT_BIND=127.0.0.1
VAULT_PORT=8200
